# Copy to .env — see docker-compose.yml for how these are used.
# .env itself is gitignored.

# Host ports for Postgres, the API and the frontend. Override if
# 5432/8080/5173 are already taken on your machine. Note: overriding
# POSTGRES_PORT only affects docker-compose's own containers (they talk to
# each other over the internal network, unaffected by this) — running
# `make run`/`make test-integration` against this Postgres from the host
# then also needs a matching DATABASE_URL (see cmd/api/main.go's default).
# POSTGRES_PORT=5432
# API_PORT=8080
# WEB_PORT=5173

# If unset, the API falls back to an insecure hardcoded dev secret and
# logs a warning (see docs/ru/adr/005-jwt-vs-sessions.md) — fine for local
# review, not beyond that. Generate a real one with:
#   openssl rand -base64 32
JWT_SECRET=
